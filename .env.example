# Clave de Anthropic (obligatoria para el chat; demo.ts no la necesita)
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-sonnet-5. Alternativa más capaz: claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5
# Puerto HTTP
PORT=3000
# Tope de iteraciones herramienta->modelo por turno
MAX_ITERACIONES=25
# Tope de tokens (entrada+salida) por sesión
MAX_TOKENS_SESION=300000
# Timeout de la llamada al modelo en ms
LLM_TIMEOUT_MS=60000
# Tope global de tokens del proceso (todas las sesiones)
MAX_TOKENS_TOTAL=3000000
